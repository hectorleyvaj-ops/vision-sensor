{
    "schema_version": 2,
    "installation": {
        "id": "vision-station",
        "name": "Sistema de vision",
        "commissioning_mode": true
    },
    "recipes": {
        "file": "core/models/recipes.json",
        "auto_migrate": true
    },
    "camera": {
        "device": null,
        "width": 1920,
        "height": 1080,
        "capture_fps": 30,
        "preview_fps": 10,
        "default_focus_mode": "calibrated"
    },
    "controller": {
        "transport": "serial",
        "protocol": "vision_controller_v1",
        "ports": {},
        "baudrate": 115200,
        "timeout": 1.0,
        "reset_on_connect": true,
        "heartbeat_enabled": true,
        "ready_notifications_enabled": true,
        "model_map": {}
    },
    "runtime": {
        "require_controller_ready": true,
        "require_controller_sync": true,
        "require_focus_ready": true,
        "max_frame_age_seconds": 0.5,
        "mechanical_settle_ms": 0,
        "inspection_timeout_seconds": 20.0
    },
    "traceability": {
        "enabled": true,
        "directory": "runtime/traceability",
        "max_file_size_mb": 10.0,
        "retention_files": 10,
        "retention_days": 30
    }
}
