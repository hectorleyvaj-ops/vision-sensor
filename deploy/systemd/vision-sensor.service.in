[Unit]
Description=Vision Sensor graphical runtime
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
EnvironmentFile=@ENVIRONMENT_FILE@
WorkingDirectory=@CURRENT_RELEASE@
ExecStart=@CURRENT_RELEASE@/scripts/launch_vision.sh
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=120
StartLimitBurst=3
TimeoutStopSec=20
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical-session.target
