+            "controller.configuration",
+            "ERROR",
+            "controller",
+            str(exc),
+            action=f"Agrega un puerto para la plataforma {platform}",
+            blocking=True,
+        )
+
+    camera = system_config.section("camera")
+    manager.update(
+        "camera.runtime",
