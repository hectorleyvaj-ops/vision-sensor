+                cycle=trigger.fields["CYCLE"],
+                result="OK",
+            )
+        )
+        conflict = decode_message(
+            self.controller.receive(
+                encode_message(
+                    "VISION_RESULT",
+                    cycle=trigger.fields["CYCLE"],
+                    result="NG",
